# Optional. The API defaults to port 3000.
PORT=3000

# PostgreSQL connection URI
PG_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Clerk server key. Keep this private; do not use the VITE_ publishable key here.
CLERK_SECRET_KEY=sk_test_...
# The same public key used by the frontend, without the VITE_ prefix.
CLERK_PUBLISHABLE_KEY=pk_test_...

# Comma-separated origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Cloudinary credentials, required for event and venue image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
